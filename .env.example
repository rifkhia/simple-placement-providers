# Full base URL of the backend API, including any path prefix. Examples:
#   http://localhost:5000
#   https://api-gateway-test.internal.example.com/placement-api
VITE_API_BASE_URL=http://localhost:5000

# Basic Auth credentials for the backend. The Vite proxy injects these
# server-side, so they never reach the browser bundle.
VITE_BACKEND_USER=admin
VITE_BACKEND_PASSWORD=secret

# Hostname the preview server is allowed to be served under. Set this when
# running behind a reverse proxy; leave unset for plain localhost.
# VITE_ALLOWED_HOST=app.internal.example.com
